{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".clasp.json",
      ".claspignore",
      "firestore.rules",
      "appsscript.json",
      "Code.gs",
      "*.md",
      ".git/**",
      ".github/**",
      ".claude/**",
      ".agents/**",
      "node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index_travel.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
